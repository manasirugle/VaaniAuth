# Model Paths (optional overrides)
# SPEECHBRAIN_MODEL_PATH=custom/path/to/model
# WHISPER_MODEL=base

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_MONTH=100000

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
