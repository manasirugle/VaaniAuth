# VaaniAuth Backend Environment Variables
# Copy this file to .env and fill in your values

# MongoDB connection
MONGODB_URI=mongodb+srv://aryankulkarni1104:Aryan%402005@cluster0.qxaih.mongodb.net/

# API Security
API_SECRET_KEY=your_api_secret_key_here
JWT_SECRET=your_jwt_secret_here
